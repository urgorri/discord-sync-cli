{
  "name": "discord-sync-cli",
  "version": "1.0.0",
  "description": "A lightweight, declarative CLI tool to export, manage, and synchronize Discord server structures.",
  "main": "bin/cli.js",
  "type": "module",
  "bin": {
    "discord-sync": "./bin/cli.js"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "dev": "node ./bin/cli.js",
    "test": "node --test tests/**/*.test.js",
    "pull": "node ./bin/cli.js pull",
    "push": "node ./bin/cli.js push"
  },
  "keywords": [
    "discord",
    "cli",
    "discord-sync",
    "discord-bot",
    "discord-js",
    "infrastructure-as-code",
    "declarative-discord"
  ],
  "author": "Gastón Urgorri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urgorri/discord-sync-cli.git"
  },
  "bugs": {
    "url": "https://github.com/urgorri/discord-sync-cli/issues"
  },
  "homepage": "https://github.com/urgorri/discord-sync-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "discord.js": "^14.17.0",
    "dotenv": "^16.4.7",
    "ora": "^8.2.0"
  }
}
